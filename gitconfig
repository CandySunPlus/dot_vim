[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
[init]
  defaultBranch = main
[user]
	name = NikSun
	email = candysfm@gmail.com
[core]
  editor = nvim
  pager = delta
	quotepath = false
[include]
	path = ~/.config/delta/catppuccin.gitconfig

[delta]
  features = catppuccin-<flavour>
  navigate = true
  light = false

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default
[interactive]
  diffFilter = delta --color-only
[pull]
  release = true
  rebase = true
  autoSetupRemote = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[push]
	autoSetupRemote = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

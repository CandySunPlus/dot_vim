# —— 字体 ——
font-family = Iosevka Custom
font-family = Sarasa Term SC
font-size = 13

# —— 白纸 + 墨水笔（background 必须与 shader 里 PAPER_BG 一致）——
background = f6f4ee
foreground = 1f2433
cursor-color = 1f2433
selection-background = f5e9a0
selection-foreground = 1f2433

# 墨水笔色板：蓝黑、红笔、绿、蓝圆珠笔、紫……
palette = 0=#1f2433
palette = 1=#b22a2a
palette = 2=#2e6b3f
palette = 3=#a3711a
palette = 4=#1f4e9c
palette = 5=#6e3a8a
palette = 6=#1f6d7a
palette = 7=#8b8f99
palette = 8=#6b7080
palette = 9=#c8402f
palette = 10=#3f8a52
palette = 11=#b8862a
palette = 12=#2f62b8
palette = 13=#8a4fa8
palette = 14=#2a8a96
palette = 15=#3a3f4d

# —— 纸纹 shader ——
custom-shader = shaders/paper-white.glsl
custom-shader-animation = false

window-padding-x = 18
window-padding-y = 14

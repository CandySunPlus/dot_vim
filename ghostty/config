# —— 字体 ——
font-family = Iosevka Custom
font-family = IosevkaCustom Nerd Font Mono
font-family = Sarasa Term SC
font-size = 12
adjust-cell-height = 5%

# —— 配色：Catppuccin Mocha（黑纸）；换成 Catppuccin Latte 即白纸，shader 会自动适配 ——
theme = Catppuccin Mocha

# —— 纸纹 shader ——
# 纸色从内边距读取，自动适配当前主题（window-padding 不能为 0）
custom-shader = shaders/paper.glsl
custom-shader-animation = false

window-padding-x = 6
window-padding-y = 4

# ssh 到新机器时自动安装 xterm-ghostty terminfo，装不上则回退 xterm-256color
shell-integration-features = ssh-terminfo,ssh-env
